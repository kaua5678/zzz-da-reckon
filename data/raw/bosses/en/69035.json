          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "· Suitable for Agents with <IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>Anomaly</color> specialty."
            },
            "69013303": {
              "title": "",
              "desc": "· While Corruptive Barrier is active, Anomaly DMG dealt by Agents is <color=#2BAD00>increased by 50%</color>, and Anomaly Buildup is <color=#2BAD00>increased by 30%</color>. When the Boss is Stunned, Anomaly DMG taken is <color=#2BAD00>increased by 15%</color>, and Anomaly Buildup inflicted by Agents is <color=#2BAD00>increased by 15%</color>. When the Boss is not Stunned, DMG taken is <color=#2BAD00>reduced by 15%</color>."
            },
            "69013304": {
              "title": "",
              "desc": "· Each successful counter and subsequent trigger of a special stagger against the Boss's attacks grants <color=#FFAF2C>1,000 Performance Points</color>. During the <Term:2000003>Control Skill</Term>, each successful counter against the Boss's attacks grants <color=#FFAF2C>500 Performance Points</color>. Performing a <color=#FFAF2C>Shutdown</color> on the Boss's <color=#FFAF2C>Control Skill</color> grants <color=#FFAF2C>1,500 Performance Points</color>. Maximum obtainable Performance Points: 5,000."
            }
          },
