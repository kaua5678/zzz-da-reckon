          "layer_buff": {
            "69014504": {
              "title": "",
              "desc": "·When Integrated Scorched Horizon becomes Impaired or is hit with a Shutdown, the whole squad's Sharp DMG <color=#FFAF2C>increases by 25%</color> for 60s.\n·When an Agent's attack hits a non-Stunned enemy, Daze inflicted <color=#FFAF2C>increases by 15%</color>. When Integrated Scorched Horizon is Stunned, the Stun DMG Multiplier <color=#FFAF2C>increases by 30%</color>."
            },
            "69014505": {
              "title": "",
              "desc": "· When Scorched Horizon is in <color=#FFFFFF>Gale Scorcher</color> state, Impairing them grants <color=#FFAF2C>1,250 Performance Points</color>. <color=#FFAF2C>Striking down Scorched Horizon when they're attacking in mid-air</color> grants <color=#FFAF2C>1,500 Performance Points</color>. Performing a <color=#FFAF2C>Shutdown</color> against Scorched Horizon's <Term:2000003></Term> grants <color=#FFAF2C>2,000 Performance Points</color>. Max 5,000 Performance Points."
            }
          },
