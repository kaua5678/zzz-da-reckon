            "69010701": {
              "title": "Swift Advance",
              "desc": "· DMG dealt by Agent <color=#FFFFFF>Aftershocks</color> and <color=#FFFFFF>Chain Attacks</color> is <color=#2BAD00>increased by 30%</color>.\n· When an <color=#FFFFFF>Aftershock</color> or <color=#FFFFFF>Dodge Counter</color> hits an enemy, all squad members' ATK is <color=#2BAD00>increased by 15%</color>, and CRIT DMG is <color=#2BAD00>increased by 40%</color> for 20s. Repeated triggers reset the duration."
            },
            "69010801": {
              "title": "Worn Out",
              "desc": "· The Daze dealt by Agents is increased by <color=#2BAD00>10%</color>, and the DMG dealt by Chain Attacks is increased by <color=#2BAD00>50%</color>.\n· When <color=#FFFFFF>Chain Attacks</color> hit an enemy, the enemy's Stun DMG Multiplier is increased by <color=#2BAD00>25%</color>, and all squad members' ATK is increased by <color=#2BAD00>20%</color> for 15s. Repeated triggers reset the duration."
            },
