        "6904001": {
          "name": "Girtablullu",
          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "· Suitable for Agents with <IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>Anomaly</color> specialty."
            },
            "69013903": {
              "title": "69013903_Title",
              "desc": "· Whenever an Agent inflicts an Anomaly on the Boss, they apply 1 stack of Shadow to it. Each stack of Shadow increases the Boss's <color=#2BAD00>Anomaly DMG taken by 7.5%</color> and additionally increases its Vortex DMG taken <color=#2BAD00>by 5%</color> for <color=#2BAD00>10s</color>. Shadow can stack up to <color=#2BAD00>3 times</color>. The duration of each stack is calculated separately. During <Term:2000001>Corruptive Barrier</Term>, applying Shadow to the Boss additionally reduces the <color=#FFAF2C>Corruptive Barrier</color> by <color=#2BAD00>20% of its max value</color> and accumulates <color=#2BAD00>15% Daze</color> (cannot be repeatedly triggered within 15s). When the <color=#FFAF2C>Corruptive Barrier</color> is broken, the Boss immediately gains max stacks of Shadow. When the Boss is Stunned, all Shadow stacks are removed and an equal number of Laceration stacks are applied. Each stack of Laceration reduces the Boss's <color=#2BAD00>Anomaly Buildup RES by 5%</color> and increases its <color=#2BAD00>Stun DMG Multiplier by 10%</color>. When the Boss's Stunned state ends, all Laceration stacks are removed."
            },
            "69013904": {
              "title": "69013904_Title",
              "desc": "· Each successful parry against Girtablullu's consecutive downward smashes after it activates Corruptive Barrier grants <color=#FFAF2C>1,000 Performance Points</color>. Successfully triggering a <Term:2000004>Chain Parry</Term> against the final slam grants an additional <color=#FFAF2C>1,000 Performance Points</color>. <color=#FFAF2C>Successfully breaking the Corruptive Barrier</color> grants <color=#FFAF2C>1,500 Performance Points</color>. Maximum obtainable Performance Points: 5,000."
            }
          },
