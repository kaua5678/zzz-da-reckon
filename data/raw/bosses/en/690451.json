        "69045201": {
          "name": "Integrated: Phaethon of the Scorched Horizon",
          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69014504": {
              "title": "",
              "desc": "·When Integrated Scorched Horizon is Impaired or met with a Shutdown, the whole squad's <color=#FFAF2C>Sharp DMG increases by 40%</color>, lasting 60s; repeated triggers reset the duration. \n·When an Agent's attack hits a non-Stunned enemy, the Daze inflicted is <color=#FFAF2C>increased by 15%</color>. When Integrated Scorched Horizon is Stunned, the Stun DMG Multiplier is <color=#FFAF2C>increased by 20%</color>."
            },
            "69014505": {
              "title": "",
              "desc": "·While Integrated Scorched Horizon is in the <color=#FFFFFF>[Mist Veil]</color> state, use <color=#FFFFFF>[Defensive Assist]</color> to counter Integrated Scorched Horizon's attacks and Impair it to earn <color=#FFAF2C>1500 Performance Points</color>; <color=#FFAF2C>[Shutdown]</color> Integrated Scorched Horizon's <Term:2000003></Term> to earn <color=#FFAF2C>2000 Performance Points</color>. A maximum of 5000 Performance Points can be earned."
            },
