            "69012901": {
              "title": "Adjudication",
              "desc": "· While in Ether Veil, Agent ATK <color=#2BAD00>increases by 20%</color>, CRIT DMG <color=#2BAD00>increases by 20%</color>.\n· Enemy Stun DMG Multiplier <color=#2BAD00>increases by 30%</color>, and when Agent Basic Attacks and Ultimates hit enemies, they ignore <color=#2BAD00>10%</color> of <color=#F0D12B>Physical RES</color> and <color=#2BAD00>10%</color> of DEF."
            },
            "69012902": {
              "title": "Frost Night",
              "desc": "· Agent <color=#98EFF0>Ice DMG</color> and <color=#F0D12B>Physical DMG</color> <color=#2BAD00>increase by 30%</color>.\n· When inflicting Attribute Anomaly on enemies, the whole squad's ATK <color=#2BAD00>increases by 25%</color> and Decibel Generation Rate <color=#2BAD00>increases by 20%</color> for 20s. Repeated triggers reset the duration."
            },
